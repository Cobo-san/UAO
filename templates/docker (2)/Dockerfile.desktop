# Cobo-San Remote Desktop Endpoint Dockerfile
FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    xfce4 \
    xfce4-goodies \
    xrdp \
    dbus-x11 \
    sudo \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash desktopuser && \
    echo "desktopuser:cobo2026" | chpasswd && \
    usermod -aG sudo desktopuser

RUN echo "exec startxfce4" > /home/desktopuser/.xsession && \
    chown desktopuser:desktopuser /home/desktopuser/.xsession

EXPOSE 3389

CMD ["/usr/sbin/xrdp", "-nodaemon"]
